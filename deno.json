{
  "name": "@chordwiki/chordpro-parser",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "build": "deno run -A npm:peggy@5.0.6 --format es --dts -o src/grammar/chordpro.js src/grammar/chordpro.peggy",
    "check": "deno fmt --check . && deno lint . && deno check src/mod.ts",
    "test": "deno test"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "deno.json",
      "src/"
    ]
  },
  "fmt": {
    "exclude": [
      "src/grammar/chordpro.js",
      "src/grammar/chordpro.d.ts"
    ],
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      "src/grammar/chordpro.js",
      "src/grammar/chordpro.d.ts"
    ]
  }
}
